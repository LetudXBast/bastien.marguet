    "cv": "<ul class=\"cv-list\">\n            <li class=\"cv-item\">\n              <strong>2019 - 2022</strong> :\n              <em>Doctorat en physique statistique</em><br>\n              Intitulé : <em>Interfaces confinées hors-équilibre</em><br>\n              <a href=\"https://ilm.univ-lyon1.fr\" target=\"_blank\" rel=\"noopener noreferrer\">Institut Lumière Matière</a> - <a href=\"https://www.univ-lyon1.fr\" target=\"_blank\" rel=\"noopener noreferrer\">Université Claude Bernard Lyon 1</a>, Villeurbanne (69)\n            </li>\n\n            <li class=\"cv-item\">\n              <strong>2018 - 2019</strong> :\n              <em>Master 2 recherche - Physique, concepts et applications</em><br>\n              <a href=\"https://www.ens-lyon.fr\" target=\"_blank\" rel=\"noopener noreferrer\">École Normale Supérieure de Lyon</a>, Lyon (69)\n            </li>\n\n            <li class=\"cv-item\">\n              <strong>2016 - 2017</strong> :\n              <em>Master 2 enseignement - Agrégation de Physique-Chimie</em><br>\n              <a href=\"https://www.ens-paris-saclay.fr\" target=\"_blank\" rel=\"noopener noreferrer\">École Normale Supérieure de Paris-Saclay</a>, Cachan (94)\n            </li>\n\n            <li class=\"cv-item\">\n              <strong>2014 - 2016</strong> :\n              <em>Licence 3 &amp; Master 1 - Parcours PHYTEM</em><br>\n              <a href=\"https://www.ens-paris-saclay.fr\" target=\"_blank\" rel=\"noopener noreferrer\">École Normale Supérieure de Paris-Saclay</a>, Cachan (94)\n            </li>\n\n            <li class=\"cv-item\">\n              <strong>2012 - 2014</strong> :\n              <em>CPGE - Physique, Sciences Industrielles (PSI)</em><br>\n              <a href=\"https://fr.wikipedia.org/wiki/Lyc%C3%A9e_Condorcet_(Belfort)\" target=\"_blank\" rel=\"noopener noreferrer\">Lycée Condorcet</a>, Belfort (90)\n            </li>\n          </ul>\n        ",
    "responsabilites": "<ul class=\"list-clean\">\n            <li>\n              <strong><a class=\"link-accent\" href=\"https://doctorat.gouv.fr/apr%C3%A8s-le-doctorat/portraits-t%C3%A9moignages/bastien-marguet/\" target=\"_blank\" rel=\"noopener noreferrer\">Ambassadeur du doctorat - Région AURA</a></strong><br>\n              <a class=\"link-accent\" href=\"https://www.enseignementsup-recherche.gouv.fr/fr\" target=\"_blank\" rel=\"noopener noreferrer\">\n                Ministère de l'Enseignement Supérieur, de la Recherche et de l'Espace (MESRE)\n              </a><br>\n              2025 - présent\n            </li>\n\n            <li>\n              <strong>Responsable Licence Professionnelle CESP</strong>\n              (Chargé de projet Électro-Hydro-Mécanique pour systèmes de pompage)<br>\n              <a class=\"link-accent\" href=\"http://iut.univ-lyon1.fr/lpcesp\" target=\"_blank\" rel=\"noopener noreferrer\">IUT GCGP, Villeurbanne</a>\n              •\n              <a class=\"link-accent\" href=\"https://vienne.educagri.fr/licence-pro-cesp/\" target=\"_blank\" rel=\"noopener noreferrer\">Lycée Agrotech, Vienne</a>\n              •\n              <a class=\"link-accent\" href=\"https://galilee.ent.auvergnerhonealpes.fr/formations-a-galilee/apres-le-bac/licence-professionnelle-charge-de-projet-electro-hydro-mecanique-pour-systeme-de-pompage-ex-gmsp-/licence-professionnelle-charge-de-projet-electro-hydro-mecanique-pour-systeme-de-pompage-ex-gmsp--650.htm\" target=\"_blank\" rel=\"noopener noreferrer\">\n                Lycée Galilée, Vienne\n              </a><br>\n              2023 - présent\n            </li>\n          </ul>\n        ",
    "recherches": "<ul class=\"research-list modern-research\">\n            <li class=\"research-item\">\n              <span class=\"highlight\">2019 - 2022 (3 ans)</span>\n              <div>\n                <em>Doctorat - <a href=\"https://ilm.univ-lyon1.fr\" target=\"_blank\" rel=\"noopener noreferrer\">Institut Lumière Matière (ILM)</a>, <a href=\"https://www.univ-lyon1.fr\" target=\"_blank\" rel=\"noopener noreferrer\">Université Claude Bernard Lyon 1</a></em><br>\n                <strong>Interfaces confinées hors équilibre : modélisation, dynamique et phénomènes collectifs</strong>.<br>\n                Superviseur : <a class=\"link-accent\" href=\"https://ilm-perso.univ-lyon1.fr/~opl/\" target=\"_blank\" rel=\"noopener noreferrer\">Olivier Pierre-Louis</a>\n              </div>\n            </li>\n\n            <li class=\"research-item\">\n              <span class=\"highlight\">2019 (4 mois)</span>\n              <div>\n                <em>Stage M2 - <a href=\"https://lpmmc.cnrs.fr\" target=\"_blank\" rel=\"noopener noreferrer\">LPMMC</a> &amp; <a href=\"https://liphy.univ-grenoble-alpes.fr\" target=\"_blank\" rel=\"noopener noreferrer\">LiPhy</a>, <a href=\"https://www.univ-grenoble-alpes.fr\" target=\"_blank\" rel=\"noopener noreferrer\">Université Grenoble Alpes</a></em><br>\n                <strong>Étude des (super)symétries dans la dynamique d'interfaces stochastiques</strong>.<br>\n                Superviseurs : <a class=\"link-accent\" href=\"https://lpmmc.cnrs.fr/homepage-leonie-canet/\" target=\"_blank\" rel=\"noopener noreferrer\">Léonie Canet</a>, <a class=\"link-accent\" href=\"https://liphy-annuaire.univ-grenoble-alpes.fr/pages_personnelles/vivien_lecomte/\" target=\"_blank\" rel=\"noopener noreferrer\">Vivien Lecomte</a>\n              </div>\n            </li>\n\n            <li class=\"research-item\">\n              <span class=\"highlight\">2017 - 2018 (10 mois)</span>\n              <div>\n                <em>Assistant de recherche - <a href=\"https://www.ims.ac.jp/en/\" target=\"_blank\" rel=\"noopener noreferrer\">Institute for Molecular Science (IMS)</a>, Okazaki, Japon</em><br>\n                <strong>Transport électronique dans un cristal de Rydberg ultrafroid corrélé</strong>.<br>\n                Team : Pr Kenji Ohmori - <a class=\"link-accent\" href=\"https://ohmori.ims.ac.jp/en/\" target=\"_blank\" rel=\"noopener noreferrer\">Ohmori Group</a>\n              </div>\n            </li>\n\n            <li class=\"research-item\">\n              <span class=\"highlight\">2016 (4 mois)</span>\n              <div>\n                <em>Stage M1 - <a href=\"https://www.cornell.edu\" target=\"_blank\" rel=\"noopener noreferrer\">Cornell University</a>, Ithaca (NY, USA)</em><br>\n                <strong>Dynamique d'imbibition dans des milieux nanoporeux</strong>.<br>\n                Superviseur : <a class=\"link-accent\" href=\"https://ilm-perso.univ-lyon1.fr/~ovincent/\" target=\"_blank\" rel=\"noopener noreferrer\">Olivier Vincent</a> - <a class=\"link-accent\" href=\"https://stroockgroup.net/people\" target=\"_blank\" rel=\"noopener noreferrer\">Stroock Group</a>\n              </div>\n            </li>\n          </ul>\n\n          "
  },
